{
  "name": "contour-lms",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "env:local": "node scripts/env-local.mjs",
    "db:schema": "supabase db dump --local --schema public,private -f supabase/schema.sql",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "test:db": "supabase test db",
    "test:unit": "vitest run --project unit --project ui",
    "test:integration": "vitest run --project integration",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:browsers": "playwright test --project=e2e-firefox --project=e2e-webkit --workers=2",
    "test": "npm run test:db && npm run test:unit && npm run test:integration && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^29.1.1",
    "msw": "^3.0.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
